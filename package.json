{
  "name": "@hapi/mimos",
  "description": "Mime database interface",
  "version": "7.0.1",
  "repository": "git://github.com/hapijs/mimos",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "mime",
    "database",
    "content-type"
  ],
  "eslintConfig": {
    "extends": [
      "plugin:@hapi/module"
    ],
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": 2022
    },
    "overrides": [
      {
        "files": ["*.ts"],
        "parser": "@typescript-eslint/parser"
      }
    ]
  },
  "dependencies": {
    "@hapi/hoek": "^11.0.2",
    "mime-db": "^1.53.0"
  },
  "devDependencies": {
    "@hapi/code": "^9.0.0",
    "@hapi/eslint-plugin": "^6.0.0",
    "@hapi/lab": "^25.0.0",
    "@types/node": "^20",
    "@typescript-eslint/parser": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8"
  },
  "scripts": {
    "test": "node --import tsx --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 --test-coverage-exclude=test/** test/index.ts",
    "lint": "tsc --noEmit && eslint . --ext .js,.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "license": "BSD-3-Clause"
}
